# Vapi
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
# The number users dial. Displayed in the app; never dialled by this backend.
VAPI_PHONE_NUMBER=+15550000000
VAPI_PHONE_NUMBER_ID=

# Public HTTPS base URL Vapi sends webhooks to (e.g. an ngrok URL in dev).
PUBLIC_SERVER_URL=https://example.ngrok.app

PORT=3000
LOG_LEVEL=info
